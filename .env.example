# 어떤 LLM 을 쓸지: groq (무료) 또는 claude (유료)
LLM_PROVIDER=groq

# Groq — https://console.groq.com 에서 무료 발급 (카드 불필요)
GROQ_API_KEY=gsk_...
# 앞에서부터 순서대로 시도. 한 모델이 분당 한도에 걸리면 다음 모델로 자동 전환
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Claude — https://console.anthropic.com (LLM_PROVIDER=claude 일 때만 필요)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# 제보함(/admin/reports) 보호용. 비워두면 내 컴퓨터(localhost)에서만 열립니다.
# 공개 서버에 올릴 때는 아무도 못 맞출 긴 문자열을 넣고 /admin/reports?token=값 으로 접속하세요.
ADMIN_TOKEN=

# 공개 운영용 사용량 제한 (비워두면 아래 기본값)
CHAT_LIMIT_PER_IP=40      # 한 사람이 하루에 보낼 수 있는 질문 수
CHAT_LIMIT_TOTAL=1500     # 전체 하루 질문 수
CHAT_LIMIT_PER_MIN=8      # 1분당 연타 방지

# 서버가 켜질 때 학교 홈페이지를 직접 긁을지. 평소에는 끄고 (GitHub Actions 가 하루 2번 수집),
# 수집기를 손봤을 때만 1 로 켜서 확인한다.
SCRAPE_ON_START=

# 식당 리뷰를 보관할 Postgres. 비워두면 파일(reviews/reviews.jsonl)에 저장하는데,
# 무료 호스팅은 디스크가 임시라 서버가 다시 뜰 때 리뷰가 사라진다.
# Supabase 프로젝트의 Connection string (Transaction pooler, 6543 포트) 을 넣는다.
DATABASE_URL=
