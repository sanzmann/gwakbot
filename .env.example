# 어떤 LLM 을 쓸지: groq (무료) 또는 claude (유료)
LLM_PROVIDER=groq

# Groq — https://console.groq.com 에서 무료 발급 (카드 불필요)
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b
# 더 큰 모델: GROQ_MODEL=openai/gpt-oss-120b

# Claude — https://console.anthropic.com (LLM_PROVIDER=claude 일 때만 필요)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5
